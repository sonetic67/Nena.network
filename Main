    <script>
        const menuToggle = document.getElementById('menuToggle');
        const navOverlay = document.getElementById('navOverlay');

        menuToggle.addEventListener('click', () => {
            menuToggle.classList.toggle('active');
            navOverlay.classList.toggle('open');
            document.body.style.overflow = navOverlay.classList.contains('open') ? 'hidden' : 'auto';
        });

        function switchView(viewName) {
            menuToggle.classList.remove('active');
            navOverlay.classList.remove('open');
            document.body.style.overflow = 'auto';

            document.getElementById('galleryView').classList.remove('active-view');
            document.getElementById('timelineView').classList.remove('active-view');
            document.getElementById('galleryView').style.display = 'none';

            if (viewName === 'gallery') {
                document.getElementById('galleryView').style.display = 'block';
                document.getElementById('galleryView').classList.add('active-view');
            } else if (viewName === 'timeline') {
                document.getElementById('timelineView').classList.add('active-view');
            }
        }

        let currentCollection = 1;
        function switchCollection(targetNum) {
            currentCollection = targetNum;
            document.querySelectorAll('.collection-wrapper').forEach(el => el.classList.remove('active-collection'));
            document.getElementById(`col-${targetNum}`).classList.add('active-collection');
        }

        const grid1 = document.getElementById('grid-1');
        const grid2 = document.getElementById('grid-2');
        const buffer1 = document.getElementById('buffer-1');
        const buffer2 = document.getElementById('buffer-2');

        let scrollAccumulator1 = 0;
        let scrollAccumulator2 = 0;
        const threshold = 3;

        grid1.addEventListener('wheel', (e) => {
            if (grid1.scrollTop + grid1.clientHeight >= grid1.scrollHeight - 15) {
                if (e.deltaY > 0) {
                    scrollAccumulator1++;
                    buffer1.classList.add('resistance-active');
                    e.preventDefault();

                    if (scrollAccumulator1 >= threshold) {
                        scrollAccumulator1 = 0;
                        buffer1.classList.remove('resistance-active');
                        switchCollection(2);
                    }
                }
            } else {
                scrollAccumulator1 = 0;
                buffer1.classList.remove('resistance-active');
            }
        });

        grid2.addEventListener('wheel', (e) => {
            if (grid2.scrollTop === 0) {
                if (e.deltaY < 0) {
                    scrollAccumulator2++;
                    buffer2.classList.add('resistance-active');
                    e.preventDefault();

                    if (scrollAccumulator2 >= threshold) {
                        scrollAccumulator2 = 0;
                        buffer2.classList.remove('resistance-active');
                        switchCollection(1);
                    }
                }
            } else {
                scrollAccumulator2 = 0;
                buffer2.classList.remove('resistance-active');
            }
        });

        function toggleRow(element) {
            const row = element.closest('.timeline-row');
            row.classList.toggle('shifted');
        }

        function slideTimeline(val) {
            const rows = document.querySelectorAll('.timeline-row');
            rows[val].scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        const timelineView = document.getElementById('timelineView');
        const rows = document.querySelectorAll('.timeline-row');
        const rangeInput = document.getElementById('timelineRange');

        timelineView.addEventListener('scroll', () => {
            let closestIndex = 0;
            let minDistance = Infinity;

            rows.forEach((row, index) => {
                const rect = row.getBoundingClientRect();
                const distance = Math.abs(rect.top - window.innerHeight / 2);
                if (distance < minDistance) {
                    minDistance = distance;
                    closestIndex = index;
                }
            });

            rangeInput.value = closestIndex;
        });
    </script>
