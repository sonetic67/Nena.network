<script>
      fetch('content.json')
        .then(response => response.json())
        .then(data => {
          // GitHub API liefert den Dateiinhalt im Feld 'content', base64-codiert
          if (data && data.content) {
            const decodedJsonString = decodeURIComponent(escape(atob(data.content.replace(/\s/g, ''))));
            const items = JSON.parse(decodedJsonString);
            
            console.log("Geladene Bilder-Daten:", items);
            
            // Hier werden die Elemente später in deine Galerie/Timeline gerendert
            // (Sobald du magst, bauen wir hier die Schleife für deine Galerie ein!)
          }
        })
        .catch(error => {
          console.log("content.json ist noch leer oder wird initialisiert:", error);
        });
    </script>
</body>
</html>
